    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.15.0",
    "@web3-university/shared": "workspace:*",
    "fastify": "^5.5.0",
    "viem": "^2.37.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "prisma": "^6.15.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
