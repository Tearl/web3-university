    "next": "^15.5.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "viem": "^2.37.3",
    "wagmi": "^2.16.8"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "typescript": "^5.9.2",
    "wrangler": "^4.123.0"
  }
