# Defaults: 0.01 WETH + 100 YD, and 100 mUSDC + 100 YD.
DEX_WETH_LIQUIDITY_WEI=10000000000000000
DEX_WETH_YD_LIQUIDITY_WEI=100000000000000000000
DEX_MOCK_USDC_LIQUIDITY_UNITS=100000000
DEX_MOCK_USDC_YD_LIQUIDITY_WEI=100000000000000000000

# Sepolia deployment inputs (keep private keys only in .env, never commit them)
DEPLOYER_PRIVATE_KEY=
TREASURY_ADDRESS=
TEACHER_ADDRESS=
TEACHER_PRIVATE_KEY=
ORACLE_OPERATOR_ADDRESS=
STUDENT_ADDRESS=
TREASURY_PRIVATE_KEY=
STUDENT_YD_TARGET=100000000000000000000

# Oracle endpoint protection
ORACLE_API_KEY=change-me
ORACLE_NONCE_TTL_SECONDS=120
ORACLE_RATE_LIMIT_PER_MINUTE=10

# AWS-signed Oracle fallback. Store the private key in AWS Secrets Manager.
# The signer address must be derived from this key and configured on CompletionOracle.
FALLBACK_ORACLE_PRIVATE_KEY=
FALLBACK_ORACLE_SIGNER_ADDRESS=
FALLBACK_ATTESTATION_TTL_SECONDS=300

# Chainlink CRE (Functions 已停服，阶段 E 使用 CRE)
# Sepolia KeystoneForwarder 必须在实施日从 Chainlink 官方 Forwarder Directory 复核。
CRE_FORWARDER_ADDRESS=
CRE_COMPLETION_ORACLE_ADDRESS=
CRE_REQUEST_TIMEOUT_SECONDS=900
CRE_WORKFLOW_OWNER_ADDRESS=
CRE_WORKFLOW_NAME=w3u-complete
CRE_WORKFLOW_ID=
# CRE 工作流需要公网 HTTPS API，localhost 无法被 DON 访问。
CRE_API_BASE_URL=
# Anvil only. This public deterministic account #2 key is granted ORACLE_ROLE by DeployLocal.
# Never use this key on a public network.
LOCAL_ORACLE_PRIVATE_KEY=0x5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9a804cdab365a
