# Stage F Uniswap V3 (Sepolia test assets only)
MOCK_USDC_ADDRESS=
SWAP_GATEWAY_ADDRESS=
NEXT_PUBLIC_MOCK_USDC_ADDRESS=
NEXT_PUBLIC_SWAP_GATEWAY_ADDRESS=
# Official Sepolia addresses are built in; override only for a local V3 deployment.
NEXT_PUBLIC_UNISWAP_V3_FACTORY_ADDRESS=
NEXT_PUBLIC_UNISWAP_QUOTER_V2_ADDRESS=
NEXT_PUBLIC_UNISWAP_SWAP_ROUTER_02_ADDRESS=
NEXT_PUBLIC_UNISWAP_POSITION_MANAGER_ADDRESS=
